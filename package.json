{
  "name": "early-bird",
  "version": "0.1.0",
  "private": true,
  "description": "On-site home diagnostics, troubleshooting, and repair services — intake, LLM/heuristic triage, and scheduling.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "gen:totp": "node scripts/gen-totp.mjs",
    "gen:licensing": "node scripts/gen-licensing.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "next": "^15.5.0",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
