# ---------------------------------------------------------------------------
# Early Bird — environment configuration
# Copy to `.env.local` and fill in. All values here are safe defaults/examples.
# ---------------------------------------------------------------------------

# --- LLM triage (Anthropic Claude) -----------------------------------------
# Triage is LLM-primary: when this key is set, Claude performs the primary
# triage/troubleshooting and the rule-based heuristic runs alongside as a
# comparison baseline + fallback. Without a key, the heuristic is used alone.
ANTHROPIC_API_KEY=

# Model used for triage. Sonnet 5 is a good speed/quality balance for
# classification + troubleshooting. Swap to claude-haiku-4-5-20251001 for
# lower cost/latency, or claude-opus-4-8 for maximum quality.
TRIAGE_MODEL=claude-sonnet-5

# --- Storage ("flip of a switch" between drivers) --------------------------
# json     -> local JSON files under ./data (default; great for dev/MVP)
# postgres -> hosted Postgres (Vercel Postgres / Neon / Supabase). Requires
#             DATABASE_URL below and the pg-backed driver (see lib/store).
STORE_DRIVER=json

# Directory for the JSON file store (only used when STORE_DRIVER=json).
DATA_DIR=./data

# Postgres connection string (only used when STORE_DRIVER=postgres).
# e.g. postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Heuristic feedback loop -----------------------------------------------
# When true, LLM-proposed heuristic changes are applied automatically once the
# same proposal recurs AUTO_APPLY_THRESHOLD times. When false (default),
# proposals queue for manual review/apply in the admin dashboard.
HEURISTIC_AUTO_APPLY=false
AUTO_APPLY_THRESHOLD=3

# --- Admin dashboard auth ---------------------------------------------------
# Shared password for the /admin dashboard and admin APIs. When unset, admin is
# OPEN in development but LOCKED in production (set this before deploying).
ADMIN_PASSWORD=

# Optional dedicated secret for signing admin session cookies. If unset, a
# secret is derived from ADMIN_PASSWORD. Set an independent random value in
# production so rotating the password can be decoupled from sessions.
ADMIN_SESSION_SECRET=

# Admin second factor (TOTP). When set, admin login also requires a 6-digit
# authenticator code. Generate a secret with `npm run gen:totp` and enroll it
# in an authenticator app using the printed otpauth URL.
ADMIN_TOTP_SECRET=

# Non-obvious admin path. When set to anything other than "admin", the console
# is served from this secret slug (e.g. /ops-7f3a) and the literal /admin path
# returns 404. IMPORTANT: this rewrite is baked at BUILD time, so set this
# variable when you run `next build`, not only at runtime.
ADMIN_BASENAME=admin

# --- Email (confirmation + ops notifications) -------------------------------
# When RESEND_API_KEY is set, emails send via Resend. Without it, emails are
# logged to the server console (dev transport) so the app still works.
RESEND_API_KEY=

# From address for outgoing email. For Resend, use a verified domain in prod;
# the default sandbox address only delivers to the account owner.
EMAIL_FROM=Early Bird <onboarding@resend.dev>

# Optional ops inbox that receives a copy/notification for each new booking.
EMAIL_OPS=

# --- SMS (opt-in customer texts) --------------------------------------------
# When these are set, opt-in texts (e.g. "a technician has been assigned") send
# via Twilio. Without them, SMS is logged to the console (dev transport).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Technician portal ------------------------------------------------------
# Invite code required to CREATE a technician account (gates sign-up). Also
# required for the technician app to function at all. Set a strong value.
TECH_PASSCODE=

# Optional dedicated secret for signing technician session cookies. If unset, a
# secret is derived from TECH_PASSCODE. Set an independent random value in prod.
TECH_SESSION_SECRET=

# --- Geocoding (proximity sorting) ------------------------------------------
# nominatim -> OpenStreetMap Nominatim (no key; respect their usage policy)
# none      -> disabled (no proximity data; sorting falls back to recency)
GEOCODER=nominatim

# --- Billing (technician-recorded charges) ----------------------------------
# manual -> ledger only, no processing (default)
# stripe -> Stripe (requires `npm install stripe` and STRIPE_SECRET_KEY)
PAYMENTS_PROVIDER=manual
STRIPE_SECRET_KEY=
BILLING_CURRENCY=usd

# --- Business config --------------------------------------------------------
# Comma-separated service area postal prefixes (optional; empty = serve all).
SERVICE_AREA_PREFIXES=
